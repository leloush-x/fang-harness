    <string name="onboarding_welcome_title">Welcome to Fang Harness</string>
    <string name="onboarding_welcome_body">A coding agent that runs on your phone. Setup takes a few minutes, and most of it happens on its own.</string>
    <string name="onboarding_get_started">Get started</string>

    <string name="onboarding_done_title">You\'re all set</string>
    <string name="onboarding_done_body">Open a folder from the sidebar to start your first chat.</string>
    <string name="onboarding_done_body_no_model">Connect a model in Settings → Providers before your first chat.</string>
    <string name="onboarding_start">Start using Fang Harness</string>

    <string name="onboarding_runtime_title">Wolfi OS</string>
    <string name="onboarding_runtime_body">Fang Harness runs its agent inside its own Wolfi OS terminal. It downloads and sets itself up automatically, with no other app needed.</string>
    <string name="onboarding_runtime_done">Wolfi OS %1$s is ready.</string>
    <string name="onboarding_runtime_done_unnamed">Wolfi OS is ready.</string>
    <string name="onboarding_runtime_action">Set up Wolfi OS</string>
    <string name="onboarding_runtime_running">Setting up Wolfi OS…</string>
    <string name="onboarding_runtime_note">Wolfi OS is downloaded once, so the first setup needs a network connection.</string>

    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">Fang Harness notifies you when a chat finishes or needs your answer while you\'re away.</string>
    <string name="onboarding_notifications_blocked">Android won\'t ask again. In settings, turn on All\u00A0Fang\u00A0notifications.</string>
    <string name="onboarding_notifications_blocked_note">Samsung, OnePlus, Oppo: Allow\u00A0notifications\nXiaomi: Show\u00A0notifications</string>
    <string name="onboarding_notifications_done">Notifications are on.</string>

    <string name="onboarding_background_title">Run in the background</string>
    <string name="onboarding_background_body">Keeps a chat going while the screen is off or you\'re in another app. Without it, Android can cut the agent off mid-task. When Android asks, tap Allow.</string>
    <string name="onboarding_background_done">Fang Harness can run in the background.</string>

    <string name="onboarding_storage_title">Use phone storage</string>
    <string name="onboarding_storage_body">Needed to work on projects outside Fang Harness\'s own storage, such as Downloads or Documents. In the next screen, allow Fang Harness to manage all files.</string>
    <string name="onboarding_storage_done">Fang Harness can use phone storage.</string>

    <string name="onboarding_install_title">Install the agent</string>
    <string name="onboarding_install_body">Fang Harness installs its agent, Pi %1$s, inside Wolfi OS. It takes a few minutes.</string>
    <string name="onboarding_install_checking">Checking the agent…</string>

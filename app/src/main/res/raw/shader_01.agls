uniform float4 grid;      // pitch (px), scale (px per pt), width, height (pt)
uniform float4 ink;       // dot colour, dark
uniform float4 field;     // resting light, glow, beat, failed
uniform float4 trace;     // light, y, blip height, centre x (pt)
uniform float4 scan;      // ring light, ring travel, ring spacing, displacement (pt)
uniform float4 aperture;  // centre x, y, half size (pt), unused
uniform float4 waves;     // found ripple, reply ripple, reach (pt), echo weight
uniform float4 reply;     // the reply's origin (pt), unused, unused
uniform float4 wipe;      // progress, covers, front wiggle (pt), field light
uniform float4 band;      // quiet weight, band half height (pt), unused, unused

const float PI = 3.14159265358979;

float signalGauss(float x) { return exp(-x * x); }

// One heartbeat: a sharp upward spike with a small rise after it. Negative is up.
float signalEKG(float x, float centre, float amplitude) {
  float t = (x - centre) / 40.0;
  return amplitude * (-signalGauss((t + 0.28) / 0.17) + 0.36 * signalGauss((t - 0.08) / 0.16) - 0.13 * signalGauss((t + 0.75) / 0.28));
}

// A ring that travels out to `reach` as `progress` goes 0 -> 1, lit only in flight.
float signalWave(float distance, float progress, float reach) {
  float p = clamp(progress, 0.0, 1.0);
  return signalGauss((distance - p * reach) / 26.0) * sin(PI * p);
}

half4 main(float2 position) {
  float pitch = grid.x;
  float sc = grid.y;
  float2 S = grid.zw;
  float2 cell = floor(position / pitch);
  float2 centre = (cell + 0.5) * pitch;
  float2 p = centre / sc;
  float cellPt = pitch / sc;

  // Scan rings around the aperture, and the found ripple.
  float2 ap = aperture.xy;
  float2 fromAperture = p - ap;
  float d = length(fromAperture);
  float apertureHalf = max(aperture.z, 1.0);
  float outside = smoothstep(apertureHalf * 0.9, apertureHalf * 1.3, d);
  float s = (d - apertureHalf - scan.y) / max(scan.z, 1.0);
  float rings = pow(0.5 + 0.5 * cos(2.0 * PI * s), 8.0) * exp(-(d - apertureHalf) / (0.45 * max(S.x, S.y))) * outside * scan.x;
  float r1 = signalWave(d, waves.x, waves.z) * outside;
  // The reply: Echo's comes from the server's corner; the others ring out from the beat.
  float r2 = signalWave(length(p - reply.xy), waves.y, waves.z) * waves.w;
  float r3 = signalWave(length(p - float2(trace.w, trace.y)), waves.y, waves.z) * (1.0 - waves.w) * 0.7;

  // The trace: lit where the line passes through this dot's column, so the
  // spike's steep sides stay joined.
  float traceY = trace.y;
  float y0 = traceY + signalEKG(p.x - cellPt * 0.5, trace.w, trace.z);
  float y1 = traceY + signalEKG(p.x, trace.w, trace.z);
  float y2 = traceY + signalEKG(p.x + cellPt * 0.5, trace.w, trace.z);
  float lo = min(min(y0, y1), y2);
  float hi = max(max(y0, y1), y2);
  float dy = max(max(lo - p.y, p.y - hi), 0.0);
  float line = signalGauss(dy / (0.55 * cellPt)) * trace.x;

  // Quiet Relay keeps everything in a band around the trace.
  float quiet = band.x;
  float bandLight = signalGauss((p.y - traceY) / max(band.y, 1.0));

  // The heartbeat wipe: a bright frontier crossing left to right, its edge
  // beating, covering the field behind it.
  float progress = clamp(wipe.x, 0.0, 1.0);
  float frontX = (-0.1 + progress * 1.2) * S.x + signalEKG(p.y, S.y * 0.5, wipe.z) * 0.6;
  float front = signalGauss((p.x - frontX) / 19.0) * sin(PI * progress) * wipe.y;
  float covered = clamp((frontX - p.x) / (0.08 * S.x), 0.0, 1.0) * wipe.y;

  float envelope = pow(sin(PI * clamp((p.y - 0.04 * S.y) / (0.92 * S.y), 0.0, 1.0)), 2.0);
  float beat = field.z;
  float flash = beat * 0.35 * signalGauss((p.y - traceY) / 160.0) * signalGauss((p.x - trace.w) / (0.6 * S.x));
  float base = field.x * envelope * (1.0 - quiet * 0.83) * mix(1.0, 0.65, field.w);
  float fieldLight = base + flash + (0.55 * r1 + 0.65 * (r2 + r3) + rings) * (1.0 - quiet * 0.7);
  // The field can go dark behind the first session while Relay's trace stays in its header.
  float lit = (fieldLight * wipe.w + line * 0.78) * mix(1.0, bandLight, quiet) * (1.0 - covered);
  lit += front * 0.85 * (1.0 - quiet * 0.65);
  lit = clamp(lit, 0.0, 1.0);
  if (lit < 0.002) return half4(0.0);

  // Ripples push the dots outward, a few points at most.
  float push = (r1 + r2 + r3 + rings * 0.6) * scan.w;
  float2 dir = d > 0.5 ? fromAperture / d : float2(0.0);
  float2 dotCentre = centre + dir * push * sc;
  float dist = length(position - dotCentre);
  float radius = (1.05 + clamp(r1 + r2 + r3 + front + rings * 0.5 + line * (0.5 + beat), 0.0, 1.0) * 0.6) * sc;
  float coverage = clamp(radius - dist + 0.5, 0.0, 1.0);
  float halo = field.y * lit * smoothstep(0.2, 0.5, lit) * exp(-max(dist - radius, 0.0) / (1.4 * sc)) * (1.0 - coverage);
  float alpha = clamp(lit * coverage + halo, 0.0, 1.0);
  return half4(half3(ink.rgb * alpha), half(alpha));
}
